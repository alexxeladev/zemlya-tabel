{
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(./deploy.sh)",
      "Bash(./deploy.sh *)",
      "Bash(./install.sh)",
      "Bash(./install.sh *)"
    ],
    "allow": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(sshpass *)"
    ],
    "deny": [
      "Bash(dropdb *)",
      "Bash(docker volume rm *)",
      "Bash(git reset --hard*)",
      "Bash(./deploy.sh)",
      "Bash(./deploy.sh *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/migration_reminder.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/graph_mark.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/graph_first.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
