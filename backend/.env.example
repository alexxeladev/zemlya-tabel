DATABASE_URL=postgresql+psycopg://tabel:tabel@localhost:5432/tabel
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=false
CORS_ORIGINS=http://localhost:5173
# Годовой лимит оплачиваемого больничного (дней в календарном году)
SICK_LEAVE_LIMIT_DAYS=10
# Лимит попыток входа: столько НЕУДАЧНЫХ попыток на учётку за окно — и вход
# в неё закрыт до конца окна (task_stage2_access п.2.6)
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
