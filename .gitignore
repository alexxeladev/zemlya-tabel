# ТЗ на задачи и рабочие черновики — держим локально, а не в репозитории.
# Файлы остаются на диске; в истории до коммита 00f0bef они есть и оттуда
# простым удалением не уходят.
task_*.md
up.md

# Документы для внешних читателей и рабочие черновики — держим локально.
# Пара .md (источник правды) + .docx (то, что отдают заказчику и подрядчику),
# см. «Документы в Word» в CLAUDE.md; генератор и HTML-макеты туда же.
PROJECT_CONTEXT.md
docs/API_Contract_1C.md
docs/API_Contract_1C.docx
docs/System_Functional_Spec.md
docs/System_Functional_Spec.docx
docs/TZ_1C_integration.md
docs/TZ_1C_integration.docx
docs/design/
# Каталог scripts/ лежал в игноре целиком: в нём разовые выгрузки заказчика с
# настоящими ФИО и табельными номерами. Но скрипты эксплуатации (бэкап,
# восстановление, HTTPS, проверки) заказчик запускает НА СЕРВЕРЕ после git pull —
# они обязаны быть в репозитории. Поэтому игнорируется содержимое, а .sh
# возвращаются явно: каталог не исключён, значит исключения работают
# (для исключённого КАТАЛОГА git обратные правила не применяет).
scripts/*
# Поимённо, а не маской `*.sh`: каталог общий с разовыми выгрузками заказчика,
# и маска молча утащила бы в публичный репозиторий любой новый файл с таким
# расширением. Новый скрипт эксплуатации — дописать строку сюда, заодно
# подумав, нет ли в нём персональных данных.
!scripts/ops-common.sh
!scripts/backup.sh
!scripts/restore.sh
!scripts/restore-check.sh
!scripts/enable-https.sh
!scripts/test-postgres.sh
!scripts/verify-clean-install.sh

# Выгрузки заказчика: настоящие ФИО, оклады и штрафы. В репозиторий не едут —
# на их основе сделан модуль «Вахта», см. «Проверено на реальных данных» в CLAUDE.md.
docs/*.xlsx

# Граф кода graphify — производная от репозитория, 22 МБ на прогон.
# Пересобирается локально: graphify update .  (см. CLAUDE.md)
graphify-out/

# Персональные данные заказчика (ФИО, табельные номера, ставки) — ТОЛЬКО локально,
# в git не кладутся ни в каком виде. Макеты вахты собраны по реальным файлам
# заказчика; для тестов и документации брать вымышленных людей.
vahta_*.html

# Сертификаты и приватные ключи HTTPS (deploy/certs) — на сервере, не в git.
# Ключ в репозитории означает компрометацию сайта у всех, кто клонировал.
deploy/certs/
